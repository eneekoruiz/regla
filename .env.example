# Environment Variables Example
# Copy this file to .env and set your secrets. DO NOT commit .env files with real credentials!

# Neon PostgreSQL Database URL: copy it from Neon › Connect with "Connection pooling" on.
# Paste only the URL (no `psql` or quotes around it). Set it in Vercel, never in the repo.
# The Vercel/Neon integration may provide POSTGRES_URL instead.
DATABASE_URL="postgresql://neondb_owner:password@ep-your-endpoint-pooler.c-2.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Secret Key for JWT Token Generation: 32+ random characters, different per environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="your_custom_jwt_secret_key_here"

# API Base URL (Leave empty or set to /api for single-domain deployment)
VITE_API_BASE_URL=""

# Production web/API settings
NODE_ENV="production"
PUBLIC_APP_URL="https://aura.example.com"
ALLOWED_ORIGINS="https://aura.example.com"

# Resend transactional email (recovery links)
RESEND_API_KEY="re_..."
MAIL_FROM="Aura <no-reply@aura.example.com>"

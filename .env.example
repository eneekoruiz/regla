# Environment Variables Example
# Copy this file to .env and set your secrets. DO NOT commit .env files with real credentials!

# Neon PostgreSQL Database URL
DATABASE_URL="postgresql://username:password@ep-your-cluster-pooler.aws.neon.tech/neondb?sslmode=require"

# Secret Key for JWT Token Generation
JWT_SECRET="your_custom_jwt_secret_key_here"

# API Base URL (Leave empty or set to /api for single-domain deployment)
VITE_API_BASE_URL=""

# Production web/API settings
NODE_ENV="production"
PUBLIC_APP_URL="https://aura.example.com"
ALLOWED_ORIGINS="https://aura.example.com"

# Resend transactional email (recovery links)
RESEND_API_KEY="re_..."
MAIL_FROM="Aura <no-reply@aura.example.com>"

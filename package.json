{
  "name": "regla",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently --kill-others-on-fail \"node server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint --max-warnings=0",
    "preview": "vite preview",
    "db:migrate": "node server/migrate.js",
    "test": "node --import ./tests/unit/register-typescript.mjs --test tests/unit/*.test.mjs tests/server/*.test.mjs",
    "test:coverage": "node --import ./tests/unit/register-typescript.mjs --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info tests/unit/*.test.mjs tests/server/*.test.mjs",
    "test:accounts": "node scripts/verify-accounts.mjs",
    "test:e2e": "playwright test",
    "test:selenium": "node scripts/selenium-review.mjs",
    "test:visual": "node scripts/visual-review.mjs",
    "native:sync": "npm run build && cap sync",
    "native:android": "cap open android",
    "native:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "bcrypt": "^6.0.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^13.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.47.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0",
    "selenium-webdriver": "^4.49.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}

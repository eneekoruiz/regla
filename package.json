{
  "name": "regla",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently --kill-others-on-fail \"node server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint --max-warnings=0",
    "preview": "vite preview",
    "db:migrate": "node server/migrate.js",
    "test": "node --import ./tests/unit/register-typescript.mjs --test tests/unit/*.test.mjs tests/server/*.test.mjs",
    "test:e2e": "playwright test",
    "test:selenium": "node scripts/selenium-review.mjs",
    "test:visual": "node scripts/visual-review.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.113.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "bcrypt": "^6.0.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^13.1.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.37.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "selenium-webdriver": "^4.48.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
